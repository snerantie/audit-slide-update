# Copy this file to `.env` and fill in real values.
# .env is git-ignored — never commit real credentials.

# AWS region where you've enabled Bedrock model access
AWS_REGION=us-east-1

# Bedrock model — cross-region inference profile ID for Llama 3.3 70B
# For EU deployments, use: eu.meta.llama3-3-70b-instruct-v1:0
BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0

# --- Authentication (pick ONE strategy) ---

# Option A: SageMaker Studio / Cloud9 / EC2 — leave everything blank, role auth is automatic

# Option B: local Jupyter with AWS CLI configured — leave blank, uses ~/.aws/credentials
# AWS_PROFILE=default

# Option C: explicit keys (e.g. Colab)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=       # only if using temporary credentials
